# Django Environment Configuration
SECRET_KEY=your-django-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,your-app.herokuapp.com,127.0.0.1,localhost

# Electricity & Energy Calculation Settings (Defaults shown)
ELECTRICITY_TARIFF_BASE=0.14
CARBON_INTENSITY_FACTOR=0.85

# Database Configuration (Supabase / PostgreSQL)
# Retrieve your Connection String URI from Supabase: Project Settings -> Database -> Connection string -> URI
# Replace [YOUR-PASSWORD] with your actual Supabase DB password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres?sslmode=require

# Optional production-specific security settings (Defaults shown)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
